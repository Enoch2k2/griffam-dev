# Copy to .env.local. All values below are local-only placeholders.
DATABASE_URL=postgresql://griffamdev:local-development-only@localhost:5432/griffamdev
# Neon: use a pooled URL above and a direct URL here, preserving provider TLS settings.
# DATABASE_URL_UNPOOLED=

# Public pages work without auth configuration. Admin access fails closed until complete.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integration tests use a separate PostgreSQL database ending in _test.
# TEST_DATABASE_URL=postgresql://griffamdev:local-development-only@localhost:5432/griffamdev_test
# Never prefix secrets with NEXT_PUBLIC_. Google Calendar uses a separate later integration.

# Inquiry notifications: disabled until sender domain, API key and scheduler are ready.
EMAIL_ENABLED=false
RESEND_API_KEY=
# Bare address on your verified Resend sending domain.
EMAIL_FROM=hello@notifications.griffamdev.dev
# Generate independently of BETTER_AUTH_SECRET; minimum 32 characters.
EMAIL_WORKER_SECRET=

# Resume storage: enable after provisioning the private bucket and adding credentials.
RESUME_ENABLED=false
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
